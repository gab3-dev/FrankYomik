# Stage 1: Install Python dependencies
# GPU backend: set BUILD_GPU=rocm or BUILD_GPU=cuda (default: rocm)
ARG BUILD_GPU=rocm

FROM rocm/pytorch:rocm7.2_ubuntu22.04_py3.10_pytorch_release_2.10.0 AS builder-rocm
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS builder-cuda

FROM builder-${BUILD_GPU} AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev \
        build-essential \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install PyTorch matching the GPU backend before other deps
ARG BUILD_GPU=rocm
RUN if [ "$BUILD_GPU" = "rocm" ]; then \
        pip install --no-cache-dir torch torchvision \
            --index-url https://download.pytorch.org/whl/rocm6.3; \
    else \
        pip install --no-cache-dir torch torchvision; \
    fi

COPY server/requirements.txt .
# Install deps excluding simple-lama-inpainting (its pinned deps conflict)
# and torch/torchvision (already installed above), then install lama with --no-deps
RUN pip install --no-cache-dir --upgrade pip && \
    grep -v -E 'simple-lama|^torch' requirements.txt | pip install --no-cache-dir -r /dev/stdin && \
    pip install --no-cache-dir --no-deps simple-lama-inpainting

# Stage 2: Runtime
FROM builder-${BUILD_GPU} AS runtime

ARG APP_UID=1026
ARG APP_GID=1026

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        libgl1 libglib2.0-0 \
    && apt-get purge -y software-properties-common \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# gosu for entrypoint privilege drop
RUN apt-get update && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/*

# Copy venv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Copy application code
# kindle/config.py resolves _PROJECT_ROOT = parent of kindle/ = /app/server/
WORKDIR /app/server
COPY server/ .

# Create worker user with host UID/GID so both API and worker can
# read/write the shared cache volume.
RUN echo "worker:x:${APP_UID}:${APP_GID}:worker:/home/worker:/usr/sbin/nologin" >> /etc/passwd \
    && echo "worker:x:${APP_GID}:" >> /etc/group \
    && mkdir -p /home/worker/.cache/huggingface \
                /home/worker/.cache/manga_ocr \
                /home/worker/.EasyOCR/model \
                /app/server/cache \
    && chown -R ${APP_UID}:${APP_GID} /home/worker /app

COPY docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint.sh
RUN chmod +x /usr/local/bin/worker-entrypoint.sh

ENV HOME=/home/worker
ENV HF_HOME=/home/worker/.cache/huggingface
ENV EASYOCR_MODULE_PATH=/home/worker/.EasyOCR

# Starts as root to fix volume permissions, then drops to worker user.
ENTRYPOINT ["/usr/local/bin/worker-entrypoint.sh"]
CMD ["--pipeline", "both"]
